generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String @unique
  password String
  bikes    Bike[]
}

model ModeloBike {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  modelo String @unique
  marca  String
  tipo   String // padronizado: "mtb" | "road" | "gravel" | "urbana" | "outra"
  bikes  Bike[]
}

model Bike {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  apelido      String
  ano          Int
  kmAtual      Float                 @default(0)
  userId       String                @db.ObjectId
  user         User                  @relation(fields: [userId], references: [id])
  modeloBikeId String                @db.ObjectId
  modeloBike   ModeloBike            @relation(fields: [modeloBikeId], references: [id])
  pecas        Peca[]
  pedais       Pedal[]
  manutencoes  HistoricoManutencao[]
}

model ComponenteReferencia {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  chave            String            @unique // "corrente", "cassete", "pneus"...
  nome             String
  ordem            Int               @default(0)
  unidade          String            // "km" ou "meses"
  vidaMin          Float?            // a partir daqui entra em "planejar troca"
  vidaMax          Float?            // a partir daqui é "troca urgente"
  vidaMinMtb       Float?            // faixas específicas quando a fonte separa por tipo de bike
  vidaMaxMtb       Float?
  vidaMinRoad      Float?
  vidaMaxRoad      Float?
  sinaisDesgaste   String
  observacao       String?
  fonte            String
  fonteUrl         String?
  pecas            Peca[]
  mediasComunidade MediaComunidade[]
}

// Peça instalada em uma bike específica
model Peca {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  nome             String
  kmInstalacao     Float                 @default(0)
  kmLimite         Float?
  ultimaManutencao DateTime?
  criadaEm         DateTime?
  bikeId           String                @db.ObjectId
  bike             Bike                  @relation(fields: [bikeId], references: [id])
  componenteId     String?               @db.ObjectId
  componente       ComponenteReferencia? @relation(fields: [componenteId], references: [id])
}

model Pedal {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  km     Float
  data   DateTime @default(now())
  bikeId String   @db.ObjectId
  bike   Bike     @relation(fields: [bikeId], references: [id])
}

model HistoricoManutencao {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo    String // Ex: "Revisão Geral", "Troca de Corrente"
  descricao String // Detalhes do serviço
  km        Float // Quilometragem da bike no momento do serviço
  data      DateTime @default(now())
  tipo      String // "rotina" ou "troca"
  bikeId    String   @db.ObjectId
  bike      Bike     @relation(fields: [bikeId], references: [id])
}

model MediaComunidade {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  tipoBike      String               // "mtb" | "road" | "gravel" | "urbana" | "outra"
  unidade       String               // "km" ou "meses"
  somaDuracao   Float                @default(0)
  totalTrocas   Int                  @default(0)
  mediaVidaUtil Float                @default(0)
  menorDuracao  Float?
  maiorDuracao  Float?
  atualizadoEm  DateTime             @updatedAt
  componenteId  String               @db.ObjectId
  componente    ComponenteReferencia @relation(fields: [componenteId], references: [id])

  @@unique([componenteId, tipoBike])
}